# Copy to deploy/.env on the server and fill in. Never commit the filled file.
DOMAIN=margin.alialiabadi.ir
# Pre-launch login in front of everything. Hash: docker run --rm caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=ravanyar
BASIC_AUTH_HASH=''

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=margin.alialiabadi.ir
# 1 = no real users yet; draft consent texts allowed (AGENTS.md §1 pre-launch).
RAVANYAR_PRELAUNCH=1

# 32 random bytes, base64: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy off the server: lose the master key and every encrypted field is gone.
RAVANYAR_MASTER_KEY=
RAVANYAR_BLIND_INDEX_KEY=

KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=ravanyar-code

POSTGRES_DB=ravanyar
POSTGRES_HOST=db
DB_OWNER_USER=ravanyar_owner
DB_OWNER_PASSWORD=
DB_APP_USER=ravanyar_app
DB_APP_PASSWORD=
